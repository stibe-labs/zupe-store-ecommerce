# ==============================================================================
# White-Label & Production Environment Configuration
# ==============================================================================
# Copy this file to .env.local and update the values for your brand and infrastructure.
# To white-label or migrate to a new brand, domain, or hosting:
# 1. Update NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SITE_NAME, and Branding variables below.
# 2. Update Cloudflare D1 / database ID and API credentials.
# 3. Deploy without editing any application code!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Brand Identity & White-Label Customization
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://vittaldigital.com"
NEXT_PUBLIC_SITE_NAME="Vittal Digital"
NEXT_PUBLIC_SITE_SHORT_NAME="Vittal Digital"
NEXT_PUBLIC_SITE_SLUG="vittaldigital"
NEXT_PUBLIC_SITE_TAGLINE="Premium Wellness & Herbal Formulations"
NEXT_PUBLIC_SITE_DESCRIPTION="Discover authentic premium herbal and wellness products at Vittal Digital. Express 1–2 day discreet delivery across India."
NEXT_PUBLIC_LEGAL_NAME="Vittal Digital India"
NEXT_PUBLIC_ORDER_PREFIX="VD"
CUSTOMER_EMAIL_DOMAIN="customer.vittaldigital.com"

# Visual Assets (relative to /public or absolute CDN URLs)
NEXT_PUBLIC_LOGO_URL="/vittal-digital-logo.svg"
NEXT_PUBLIC_LOGO_PNG="/vittal-digital-logo.png"
NEXT_PUBLIC_FAVICON_URL="/favicon.png"

# Customer Support & Contact Details
NEXT_PUBLIC_SUPPORT_EMAIL="support@vittaldigital.com"
NEXT_PUBLIC_SUPPORT_PHONE="+91 73567 65036"
NEXT_PUBLIC_WHATSAPP_NUMBER="916238165935"

# Warehouse & Logistics Origin (Displayed on Tracking Milestones & Invoices)
NEXT_PUBLIC_FULFILLMENT_CENTER="Vittal Digital Fulfillment Center, Ernakulam"
NEXT_PUBLIC_DISPATCH_BAY="Ernakulam Logistics Dispatch Bay"

# ------------------------------------------------------------------------------
# 2. Logistics & Courier Integration (Shiprocket / Delhivery / Bluedart)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="support@vittaldigital.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_PICKUP_LOCATION="work"
SHIPROCKET_CHECKOUT_API_KEY="your-fastrr-key"
SHIPROCKET_CHECKOUT_API_SECRET="your-fastrr-secret"

# ------------------------------------------------------------------------------
# 3. Payment Gateway (Razorpay - Optional if COD only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ------------------------------------------------------------------------------
# 4. WhatsApp Cloud API (Automated OTP & Order Confirmation)
# ------------------------------------------------------------------------------
WHATSAPP_TOKEN="EAATwm..."
WHATSAPP_PHONE_NUMBER_ID="1477900698733187"
WHATSAPP_PHONE_NUMBER="916238165935"
WHATSAPP_TEMPLATE_NAME="vittaldigital_otp"
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="vittaldigital_wa_secret_2026"

# ------------------------------------------------------------------------------
# 5. Email Automation (Transactional SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="mail.stibe.in"
SMTP_PORT="465"
SMTP_USER="support@vittaldigital.com"
SMTP_PASS="your-smtp-password"

# ------------------------------------------------------------------------------
# 6. Database & Hosting (Cloudflare D1 Database)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="4eed09d0032a07881825f4e926cb997f"
CLOUDFLARE_D1_DATABASE_ID="3a7891a3-6e90-4eab-b448-7c33aaec0c5f"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# ------------------------------------------------------------------------------
# 7. Admin Dashboard Credentials
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@vittaldigital.com"
ADMIN_PASSWORD="YourSecureAdminPassword@2026"

