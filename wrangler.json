{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vittallifestyle",
  "account_id": "4eed09d0032a07881825f4e926cb997f",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "assets": {
